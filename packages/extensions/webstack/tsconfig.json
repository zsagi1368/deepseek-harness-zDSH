{
  // Client base because src/client carries React JSX; the host-side files need
  // node ambient types on top (same shape as extensions/plugin-center).
  // References mirror every direct import of webstack sources; transitive
  // graphs stay behind each referenced project's declaration boundary.
  "extends": "../../../tsconfig.base.client.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "lib/types",
    "types": ["node"]
  },
  "include": [
    "src"
  ],
  "references": [
    {
      "path": "../../../vendor/cordis"
    },
    {
      "path": "../../../vendor/schemastery"
    },
    {
      "path": "../../client/locale"
    },
    {
      "path": "../../client/runtime"
    },
    {
      "path": "../../client/ui-conversation"
    },
    {
      "path": "../../client/ui-slots"
    },
    {
      "path": "../../core/tools"
    },
    {
      "path": "../../settings/settings"
    },
    {
      "path": "../../web/web"
    }
  ]
}
