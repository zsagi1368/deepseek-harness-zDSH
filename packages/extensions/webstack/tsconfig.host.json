{
  // Host face of a split-face client package (mirrors packages/client/workbench):
  // everything except src/client, on the host base. The host aggregate must
  // reference THIS project, never the package root or the client face — the
  // client chain reaches remotes/tsconfig.client.json and other projects whose
  // type-check consumes generated Typert artifacts that do not exist before
  // the first tsdown pass (fresh-clone `pnpm build` would fail with TS2307).
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "lib/types",
    "types": ["node"],
    "tsBuildInfoFile": "lib/tsconfig.host.tsbuildinfo"
  },
  "include": [
    "src"
  ],
  "exclude": [
    "src/client"
  ],
  "references": [
    {
      "path": "../../../vendor/cordis"
    },
    {
      "path": "../../../vendor/schemastery"
    },
    {
      "path": "../../core/tools"
    },
    {
      "path": "../../settings/settings"
    },
    {
      "path": "../../web/web"
    }
  ]
}
